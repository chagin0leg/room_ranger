 17.671-10.94 10.941-17.69 26.051-17.69 42.682 0 16.651 6.76 31.741 17.68 42.652 10.92 10.92 26.01 17.681 42.66 17.681 16.62 0 31.75-6.751 42.69-17.691' clip-rule='evenodd'/%3E%3Cpath fill='%23fff' d='M791.945 357.435c-16.131 6.391-34.581 9.041-49.112 9.321l-2.98.03c-36.812 0-70.193-13.361-94.554-35.992-24.351-22.631-39.682-54.542-40.402-91.644l-.03-2.76c0-31.111 11.01-60.123 29.651-82.854 18.621-22.701 44.862-39.151 75.363-45.172 9.871-1.95 21.561-2.72 33.262-2.47 12.23.25 24.481 1.63 34.781 3.92 7.741 1.731 15.221 4.541 21.701 8.281 7.371 4.25 13.461 9.71 17.241 16.171 3.77 6.43 5.25 13.88 3.4 22.141-.86 3.86-2.46 7.92-4.88 12.12-7.64 10.971-13 16.291-18.541 18.011-5.51 1.71-11.31-.11-19.851-3.41-10.22-4.01-21.06-7.031-31.961-7.961-10.92-.93-21.911.22-32.401 4.551a61.1 61.1 0 0 0-27.472 22.531 61.2 61.2 0 0 0-10.33 34.021c0 17.281 6.4 31.681 16.951 42.162 11.09 11.02 26.791 17.711 44.442 18.861 8.07.52 18.43-1 28.471-3.79 10.24-2.841 20.191-7.001 27.121-11.641 3.7-2.47 7.41-3.95 11.611-3.44 4.24.53 9.03 3.06 14.92 8.62 6.621 7.091 10.331 15.181 10.991 23.501.67 8.281-1.67 16.791-7.111 24.821-6.79 9.991-17.85 17.151-30.281 22.071M2820.8 184.498c3.41 6.87 10.54 7.43 14.23 1.01.41-.79 33.29-64.903 33.29-64.903 1.99-4.01 4.21-6.77 6.69-8.621 2.47-1.84 5.21-2.79 8.22-3.19 12.85-1.72 24.43-.61 33.21 3.21 18.28 7.951 22.03 28.912 12.46 45.492l-94.71 183.559c-8 15.4-28.24 20.841-44.36 20.841-14.87 0-29.27-5.691-31.43-22.061-.61-4.609.8-7.329 3.98-13.464v-.007l22.61-44.062c2.29-4.03 2.18-10.28-.46-14.131l-65.91-127.885c-3.27-6.351-3.41-10.731-1.53-14.361 7.4-14.211 33.95-19.171 47.11-16.611 11 2.15 21.09 8.221 27.22 18.261zM995.554 127.155c-7.58 14.651-27.991 54.113-30.371 58.963h.63l-.43.74c-1.23 2.14-2.68 3.55-4.18 4.29-.96.48-1.96.69-2.931.65a6.1 6.1 0 0 1-2.82-.84c-1.43-.82-2.71-2.25-3.67-4.17l-28.701-55.743q-.6-1.155-1.26-2.22c-6.13-10.05-16.101-16.061-27.111-18.201s-23.091-.42-33.402 4.981c-.95.51-1.9 1.04-2.81 1.6-4.98 3.41-8.99 6.38-10.9 10.03-1.88 3.62-1.72 8.01 1.54 14.361l65.953 128.095c1.28 1.881 1.98 4.331 2.05 6.831.08 2.49-.46 5.03-1.64 7.09l-22.611 44.052c-3.181 6.15-4.581 8.87-3.971 13.481.98 7.41 4.491 12.68 9.481 16.21 5.82 4.1 13.67 5.851 21.941 5.851 8.98 0 19.101-1.681 27.711-5.731 7.04-3.32 13.081-8.23 16.651-15.12 6.5-12.451 28.531-55.163 49.737-96.375 22.95-44.562 44.86-87.163 44.86-87.233l.05-.2c4.06-9.341 5.36-17.401 4.47-24.142-.67-4.97-2.57-9.23-5.44-12.75-2.87-3.53-6.76-6.31-11.41-8.34-8.8-3.821-20.37-4.931-33.24-3.211-3 .4-5.75 1.35-8.21 3.19-2.48 1.851-4.71 4.611-6.696 8.621-.004.014-.27.437-.749 1.204l-.003.003c-.566.905-1.431 2.287-2.518 4.033'/%3E%3C/g%3E%3Cdefs%3E%3CclipPath id='a'%3E%3Cpath fill='%23fff' d='M0 0h2934v476H0z'/%3E%3C/clipPath%3E%3C/defs%3E%3C/svg%3E") 0 50% no-repeat;
    background-size: 100% auto;
    display: flex;
    height: 50px;
    margin-left: 0;
    margin-right: 12px;
    width: 167px;
}
.brand__mark{width:31px;height:31px;position:relative;transform:rotate(-8deg)}
.brand__mark:before,.brand__mark:after{content:"";position:absolute;border:3px solid #ff1654;border-radius:2px;width:23px;height:21px}
.brand__mark:before{left:1px;top:5px} .brand__mark:after{left:6px;top:1px}
.brand__dot{color:#ff1654}
.cashback{margin-left:4px;background:#ff1654;border-radius:20px;padding:8px 16px;font-size:15px;font-weight:800}
.nav{display:flex;gap:52px;font-size:16px;font-weight:700}
.nav span{display:flex;align-items:center;gap:9px;white-space:nowrap}
.nav svg{width:22px;height:22px;stroke:#fff;fill:none;stroke-width:2}
main{width:min(1340px,calc(100% - 56px));margin:0 auto;padding:90px 0 54px}
.hero{display:grid;grid-template-columns:.92fr 1.08fr;align-items:center;min-height:500px;gap:54px}
h1{font-size:60px;line-height:1.02;letter-spacing:-2.4px;margin:0 0 32px;font-weight:800;max-width:650px}
.lead{font-size:24px;line-height:1.48;color:#686b73;margin:0 0 38px;max-width:590px}
.retry{appearance:none;border:0;background:#ff1654;color:white;font-size:20px;font-weight:800;border-radius:18px;padding:23px 48px;min-width:420px;cursor:pointer;box-shadow:0 10px 30px rgba(255,22,84,.13);transition:.15s}
.retry:hover{background:#e90043;transform:translateY(-1px)}
.retry:active{transform:translateY(0)}
.countdown{font-size:15px;color:#747780;margin:17px 10px 0}
.visual{position:relative;display:flex;justify-content:center;align-items:center;min-width:0}
.visual:before{content:"";position:absolute;width:86%;height:70%;background:#fdeef3;border-radius:48% 52% 45% 55%/52% 48% 52% 48%;z-index:0}
.visual img{position:relative;z-index:1;width:100%;max-width:690px;height:auto;display:block;border-radius:42px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:20px}
.card{background:rgba(255,255,255,.68);border:1px solid rgba(255,255,255,.95);border-radius:18px;padding:20px 22px;display:flex;gap:18px;align-items:center;min-height:112px;box-shadow:0 6px 28px rgba(37,51,89,.025)}
.icon{width:58px;height:58px;flex:0 0 58px;border-radius:50%;background:#fde8ef;display:grid;place-items:center}
.icon svg{width:29px;height:29px;stroke:#ff1654;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.card b{font-size:16px;line-height:1.3;display:block;margin-bottom:7px}
.card p{margin:0;color:#777a82;font-size:15px;line-height:1.35}
@media(max-width:1000px){
 .nav{display:none} main{padding-top:55px} .hero{grid-template-columns:1fr;gap:20px;text-align:center}
 h1{font-size:52px;margin-left:auto;margin-right:auto} .lead{margin-left:auto;margin-right:auto}
 .visual{order:-1} .visual img{max-width:580px} .retry{min-width:min(420px,100%)}
 .cards{grid-template-columns:1fr}
}
@media(max-width:600px){
 .header{height:62px} .header__inner,main{width:calc(100% - 32px)} .brand{font-size:22px;gap:9px}
 .brand__mark{width:26px;height:26px;transform:scale(.84) rotate(-8deg)} .cashback{font-size:12px;padding:6px 10px}
 main{padding:28px 0 30px} .hero{min-height:auto} h1{font-size:39px;letter-spacing:-1.4px;margin-bottom:20px}
 .lead{font-size:18px;margin-bottom:26px} .retry{font-size:17px;padding:19px 25px;border-radius:15px}
 .visual img{border-radius:26px} .cards{gap:12px;margin-top:30px} .card{text-align:left;padding:16px;min-height:96px}
}
</style>
</head>
<body>
<header class="header">
 <div class="header__inner">
  <div class="brand">
 </div>
</header>

<main>
 <section class="hero">
  <div>
   <h1>Сайт временно<br>недоступен</h1>
   <p class="lead">Сейчас у нас технические неполадки.<br>Мы уже работаем над их устранением,<br>и скоро всё снова заработает.</p>
  </div>
  <div class="visual">
   <img alt="Мы уже работаем над восстановлением сервиса"
        src="data:image/png;base64,">
  </div>
 </section>

 <section class="cards">
  <div class="card"><div class="icon"><svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="11"/><path d="M16 9v8l5 3"/></svg></div><div><b>Устраняем проблему</b><p>Наша команда уже работает<br>над восстановлением сервиса</p></div></div>
  <div class="card"><div class="icon"><svg viewBox="0 0 32 32"><path d="M16 4 26 8v7c0 7-4.2 11-10 14C10.2 26 6 22 6 15V8Z"/><path d="m11.5 16 3 3 6-7"/></svg></div><div><b>Ваши бронирования в безопасности</b><p>Все данные сохранены</p></div></div>
  <div class="card"><div class="icon"><svg viewBox="0 0 32 32"><path d="M8 22h16l-2.2-3V13a5.8 5.8 0 0 0-11.6 0v6Z"/><path d="M13 25a3.2 3.2 0 0 0 6 0"/></svg></div><div><b>Постараемся вернуться как можно быстрее</b><p>Спасибо за понимание!</p></div></div>
 </section>
</main>

</body>
</html>
