<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<title>Суточно.ру — сайт временно недоступен</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,"Helvetica Neue",sans-serif;color:#171717}
body{background:#f3f6ff}
.header{height:74px;background:#1d1d1d;color:#fff;display:flex;align-items:center}
.header__inner{width:min(1480px,calc(100% - 56px));margin:auto;display:flex;align-items:center;justify-content:space-between;gap:32px}
.brand{
  background: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='250' height='41' fill='none' viewBox='0 0 2934 476'%3E%3Cg clip-path='url(%23a)'%3E%3Cpath fill='%23ee204d' d='M2476.51 320.164c0-26.062-20.89-47.122-46.59-47.122-25.89 0-46.78 21.06-46.6 47.122 0 26.061 20.9 47.122 46.6 47.122s46.59-21.061 46.59-47.122'/%3E%3Cpath fill='%23ee204d' fill-rule='evenodd' d='M75.673 139.336c-.35-1.73-.75-3.41-1.17-5.051-5.01-18.53-21.11-9.81-24.53-22.571-4.97-18.54 47.341-21.82 60.472-25.16 34.071-8.611 81.064-29.092 130.156-42.652C289.913 31.09 340.825 25.34 374.657 15.76c13.02-3.67 59.982-26.991 64.952-8.45 3.411 12.76-14.88 13.26-9.96 31.821 7.04 25.421 26.801 56.973 36.692 92.814 11.48 41.432 13.21 87.144 20.461 113.295 2.33 8.371 7.09 12.481 11.11 15.821 11.661 7.44 12.581 22.781-1.56 26.571-7.51 2.01-18.001 5.3-30.011 5.16-6.271-.07-8.751-2.86-9.431-7.73-2.7-18.911-6.01-44.952-11.79-65.773-5.21-18.871-16.621-49.572-27.041-66.453-5.741-9.3-13.281-20.551-7.451-28.021 9.981-12.771 6.661-32.801-3.53-44.732-11.27-13.23-30.711-12.8-51.262-7.29-9.591 2.57-19.951 6.56-28.261 9.75-4.461 1.72-8.211 3.17-9.281 3.47-14.571 4.12-34.891 7.85-57.092 11.91-23.561 4.321-49.233 9.031-76.574 16.132l-.19.04c-27.241 7.53-51.822 16.29-74.383 24.331-7.37 2.63-14.52 5.18-21.331 7.54 0 0-10.75 4.31-13.05-6.63m192.519 286.952c-48.442 10.611-98.324 15.531-132.726 24.301-24.101 6.031-33.061 21.191-45.242 24.462-14.14 3.79-19.91-8.041-13.54-20.311 1.8-4.911 3.89-10.841 1.72-19.261-6.25-23.361-28.122-45.242-44.122-106.955-15.991-61.703-3.38-77.503-9.44-100.114C19.83 209.869 3.75 218.589.33 205.829c-4.97-18.551 47.342-21.821 60.443-25.151 44.262-11.221 86.124-30.442 130.176-42.662 44.261-11.441 90.133-15.731 134.065-28.142 13.021-3.68 59.953-26.99 64.923-8.45 3.42 12.761-14.86 13.261-9.93 31.821 6.06 22.611 24.881 29.982 41.872 91.424 17.01 61.443 9.01 91.325 15.27 114.686 2.331 8.37 7.111 12.47 11.121 15.81 11.66 7.451 12.57 20.581-1.56 24.361-12.191 3.27-27.53